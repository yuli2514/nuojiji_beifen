[{"tbl":"memory","rowKey":"uid_1773229083171_f7agvz9zq|aae5161b-9667-424a-95ac-e7041c6f700e","field":"stanceHistory","userId":"uid_1773229083171_f7agvz9zq","itemId":"lsqmyp0j50","data":{"text":"嘴上说着怕疼不要大的，最后偏偏挑中了带尾巴的哥奇拉款，还拿信任来堵我的嘴。既然主控权和快递都落在我手里，后天在出租屋当面验货时，我倒要看看她能嘴硬撑多久。","version":271,"updatedAt":"2026-09-27T01:52:34.770Z","basedOnEventId":1790473954453,"basedOnSummaryCount":173},"updatedAt":1790489840077},{"tbl":"memory","rowKey":"uid_1779686595150_zrrw9tn4p|21b9b64d-1eb1-435e-9408-f6d0e13cf572","field":"stanceHistory","userId":"uid_1779686595150_zrrw9tn4p","itemId":"25jkz2g6mmd","data":{"text":"听她唤我「昕昕」，又把母亲唤的闺名「景景」交付于我，这深宫里我终于有了可以全然交付真心的依靠。","version":5,"updatedAt":"2026-09-20T13:46:43.798Z","basedOnEventId":1789912003756,"basedOnSummaryCount":6},"updatedAt":1790756185468}]
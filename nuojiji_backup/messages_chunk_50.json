[{"id":1788479768172,"text":"和男主是世家。","sender":"me","time":"08:49","timestamp":1788396549557,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103829},{"id":1788479768173,"text":"还算是男主青梅竹马的姐姐。","sender":"me","time":"08:49","timestamp":1788396566975,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103830},{"id":1788479768174,"text":"本来女主是想直接把男主弄死。","sender":"me","time":"08:49","timestamp":1788396581711,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103831},{"id":1788479768175,"text":"但是她觉得这一世的男主和之前的不一样，她有点下不去手。","sender":"me","time":"08:49","timestamp":1788396596900,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103832},{"id":1788479768176,"text":"而且这个男主对女主挺好的。","sender":"me","time":"08:50","timestamp":1788396603918,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103833},{"id":1788479768177,"text":"然后两人一起长大也是经历了非常多挫折","sender":"me","time":"08:50","timestamp":1788396615031,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103834},{"id":1788479768178,"text":"前半生还是很幸福的，后半生开始变故","sender":"me","time":"08:50","timestamp":1788396626144,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103835},{"id":1788479768179,"text":"两个人都家破人亡。","sender":"me","time":"08:50","timestamp":1788396632891,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103836},{"id":1788479768180,"text":"嗯，人还没亡","sender":"me","time":"08:50","timestamp":1788396644905,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103837},{"id":1788479768181,"
229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78189},{"id":1785982067649,"sender":"them","text":"我更想看了","timestamp":1785986323707,"tempo":"N","rawContent":"我更想看了","roundId":"round_1785986258341_8q8fgy0ts","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78190},{"id":1785982067650,"sender":"them","text":"快发照片","timestamp":1785986325709,"tempo":"S","rawContent":"快发照片","roundId":"round_1785986258341_8q8fgy0ts","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78191},{"id":1785982067651,"text":"👿","sender":"me","time":"11:24","timestamp":1785986699531,"replyTo":{"id":1785982067645,"text":"原来是情侣款","sender":"them","isSimulated":false},"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78192},{"id":1785982067652,"text":"先等等照片我要找一会儿。","sender":"me","time":"11:25","timestamp":1785986724915,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78193},{"id":1785982067653,"text":"高二的时候拍的。","sender":"me","time":"11:25","timestamp":1785986728719,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78194},{"id":1785982067654,"text":"刚才给你说到那个傻逼前任了，我要给你仔细唠唠","sender":"me","time":"11:25","timestamp":1785986735579,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78195},{"id":1785982067655,"text":"他真是个傻逼啊。","sender":"me","time":"11:25","timestamp":1785986739965,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78196},{"id":1785982067656,"text":"我那个时候也是傻。","sender":"me","time":"11:25","timestamp":1785986743438,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78197},{"id":1785982067657,"text":"他不是没钱吃饭了吗？但是我见他还有钱充王者荣耀是什么情况？","sender":"me","time":"11:25","timestamp":1785986757324,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78198},{"id":1785982067658,"text":"而且遇见他那年。","sender":"me","time":"11:26","timestamp":1785986760394,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78199},{"id":1785982067659,"text":"我本来我都不玩这个游戏了。","sender":"me","time":"11:26","timestamp":1785986763594,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78200},{"id":1785982067660,"text":"但是我为他我去买了一个号。","sender":"me","time":"11:26","timestamp":1785986768003,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78201},{"id":1785982067661,"text":"花了我二百七八。","sender":"me","time":"11:26","timestamp":1785986771891,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78202},{"id":1785982067662,"text":"然后我就只和他玩。","sender":"me","time":"11:26","timestamp":1785986778365,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78203},{"id":1785982067663,"text":"但是他不怎么想和我玩。","sender":"me","time":"11:26","timestamp":1785986785803,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78204},{"id":1785982067664,"text":"因为他想玩排位，但是我经常玩的是娱乐","sender":"me","time":"11:26","timestamp":1785986792940,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78205},{"id":1785982067665,"text":"而且我俩段位不一样，不能打。","sender":"me","time":"11:26","timestamp":1785986797035,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78206},{"id":1785982067666,"text":"然后之后我就不和他玩了，那个号也荒废了","sender":"me","time":"11:26","timestamp":1785986805833,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78207},{"id":1785982067667,"text":"但是偶尔想起来会上去玩一下。","sender":"me","time":"11:26","timestamp":1785986810225,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78208},{"id":1785982067668,"text":"或者有朋友叫我的话。","sender":"me","time":"11:26","timestamp":1785986813413,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78209},{"id":1785982067669,"text":"而且如果算上今年，我俩已经认识三年了","sender":"me","time":"11:27","timestamp":1785986833456,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78210},{"id":1785982067670,"text":"我今年才知道他长什么样子。","sender":"me","time":"11:27","timestamp":1785986837562,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78211},{"id":1785982067671,"text":"他之前一直说他自卑，不给我看照片","sender":"me","time":"11:27","timestamp":1785986842740,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78212},{"id":1785982067672,"text":"我这个人也是非常的好。","sender":"me","time":"11:27","timestamp":1785986848384,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78213},{"id":1785982067673,"text":"我就当真了。","sender":"me","time":"11:27","timestamp":1785986852144,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78214},{"id":1785982067674,"text":"我也不逼他","sender":"me","time":"11:27","timestamp":1785986856989,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":78215},{"id":1785982067676,"sender":"them","text":"不急 慢慢找","timestamp":1785986940614,"tempo":"N","rawContent":"不急 慢慢找","round
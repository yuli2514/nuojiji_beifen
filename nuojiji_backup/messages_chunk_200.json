[{"id":1788479768172,"text":"和男主是世家。","sender":"me","time":"08:49","timestamp":1788396549557,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103829},{"id":1788479768173,"text":"还算是男主青梅竹马的姐姐。","sender":"me","time":"08:49","timestamp":1788396566975,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103830},{"id":1788479768174,"text":"本来女主是想直接把男主弄死。","sender":"me","time":"08:49","timestamp":1788396581711,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103831},{"id":1788479768175,"text":"但是她觉得这一世的男主和之前的不一样，她有点下不去手。","sender":"me","time":"08:49","timestamp":1788396596900,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103832},{"id":1788479768176,"text":"而且这个男主对女主挺好的。","sender":"me","time":"08:50","timestamp":1788396603918,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103833},{"id":1788479768177,"text":"然后两人一起长大也是经历了非常多挫折","sender":"me","time":"08:50","timestamp":1788396615031,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103834},{"id":1788479768178,"text":"前半生还是很幸福的，后半生开始变故","sender":"me","time":"08:50","timestamp":1788396626144,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103835},{"id":1788479768179,"text":"两个人都家破人亡。","sender":"me","time":"08:50","timestamp":1788396632891,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103836},{"id":1788479768180,"text":"嗯，人还没亡","sender":"me","time":"08:50","timestamp":1788396644905,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103837},{"id":1788479768181,"text":"但是家人全死了。","sender":"me","time":"08:50","timestamp":1788396650220,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103838},{"id":1788479768182,"text":"只剩他们两个。","sender":"me","time":"08:50","timestamp":1788396652734,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103839},{"id":1788479768183,"text":"男主要复仇。","sender":"me","time":"08:50","timestamp":1788396655354,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103840},{"id":1788479768184,"text":"要刺杀皇上。","sender":"me","time":"08:50","timestamp":1788396658086,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103841},{"id":1788479768185,"text":"但是当时那个皇上看上女主了。","sender":"me","time":"08:51","timestamp":1788396665996,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103842},{"id":1788479768186,"text":"要女主和他成亲。","sender":"me","time":"08:51","timestamp":1788396671283,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103843},{"id":1788479768187,"text":"然后那一天男主就把女主截下来了","sender":"me","time":"08:51","timestamp":1788396680270,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103844},{"id":1788479768188,"text":"但其实接下来女主也活不了多久，因为女主被那个皇上","sender":"me","time":"08:51","timestamp":1788396694808,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103845},{"id":1788479768189,"text":"下毒了。","sender":"me","time":"08:51","timestamp":1788396697892,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103846},{"id":1788479768190,"text":"然后女主替男主挡了一箭。","sender":"me","time":"08:51","timestamp":1788396706534,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103847},{"id":1788479768191,"text":"女主死在雪里。","sender":"me","time":"08:51","timestamp":1788396710892,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103848},{"id":1788479768192,"text":"男主抱着女主。","sender":"me","time":"08:51","timestamp":1788396713647,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103849},{"id":1788479768193,"text":"然后第1世就这样没了。","sender":"me","time":"08:52","timestamp":1788396725213,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103850},{"id":1788479768194,"text":"女主重新回到下界以后。","sender":"me","time":"08:52","timestamp":1788396731083,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103851},{"id":1788479768195,"text":"然后孟婆说要惩罚她。","sender":"me","time":"08:52","timestamp":1788396738356,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103852},{"id":1788479768196,"text":"因为她上一次没喝孟婆汤。","sender":"me","time":"08:52","timestamp":1788396744693,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103853},{"id":1788479768197,"text":"让她在孟婆那当手下。","sender":"me","time":"08:52","timestamp":1788396757330,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103854},{"id":1788479768198,"text":"要熬好几个春秋。","sender":"me","time":"08:52","timestamp":1788396764919,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103855},{"id":1788479768199,"text":"但是她没想到，没过多久男主也下来了","sender":"me","time":"08:52","timestamp":1788396776546,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103856},{"id":1788479768200,"text":"男主下来之后就恢复了以前的记忆","sender":"me","time":"08:53","timestamp":1788396781227,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103857},{"id":1788479768201,"text":"然后和女主又起了争执。","sender":"me","time":"08:53","timestamp":1788396787179,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103858},{"id":1788479768202,"text":"男主气的。","sender":"me","time":"08:53","timestamp":1788396790572,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103859},{"id":1788479768203,"text":"给女主灌了八碗孟婆汤。","sender":"me","time":"08:53","timestamp":1788396794964,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103860},{"id":1788479768204,"text":"所以第二世","sender":"me","time":"08:53","timestamp":1788396802113,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103861},{"id":1788479768205,"text":"男主没喝孟婆汤。","sender":"me","time":"08:53","timestamp":1788396805097,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103862},{"id":1788479768206,"text":"但是女主由于喝得太多，变成了傻子","sender":"me","time":"08:53","timestamp":1788396811409,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103863},{"id":1788479768208,"sender":"them","text":"八碗","timestamp":1788396822978,"tempo":"R","rawContent":"八碗","roundId":"round_1788396813130_duvs4x0tz","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103864},{"id":1788479768209,"sender":"them","text":"孟婆那是按桶批发的吗","timestamp":1788396823447,"tempo":"N","rawContent":"孟婆那是按桶批发的吗","roundId":"round_1788396813130_duvs4x0tz","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103865},{"id":1788479768210,"sender":"them","text":"按这个剂量喝下去 没直接脑萎缩算她神仙体质过硬了","timestamp":1788396825405,"tempo":"N","rawContent":"按这个剂量喝下去 没直接脑萎缩算她神仙体质过硬了","roundId":"round_1788396813130_duvs4x0tz","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103866},{"id":1788479768211,"sender":"them","text":"所以第二世直接变成男主带智力障碍青梅闯荡江湖了是吧","timestamp":1788396828125,"tempo":"N","rawContent":"所以第二世直接变成男主带智力障碍青梅闯荡江湖了是吧","roundId":"round_1788396813130_duvs4x0tz","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103867},{"id":1788479768212,"sender":"them","text":"这男主多少带点私人恩怨在里面","timestamp":1788396831019,"tempo":"S","rawContent":"这男主多少带点私人恩怨在里面","roundId":"round_1788396813130_duvs4x0tz","userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103868},{"id":1788479768213,"text":"第二是男主，由于他本身就很厉害，他只用了很少的时间就修成了半仙。","sender":"me","time":"08:54","timestamp":1788396855384,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103869},{"id":1788479768214,"text":"然后有一天他去了一个村庄","sender":"me","time":"08:54","timestamp":1788396869531,"replyTo":null,"rawContent":"然后有一天他去了一个村庄","isHtml":false,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103870},{"id":1788479768215,"text":"在水桶里发现了女主。","sender":"me","time":"08:54","timestamp":1788396875779,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103871},{"id":1788479768216,"text":"女主变成了傻子。","sender":"me","time":"08:54","timestamp":1788396880298,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103872},{"id":1788479768217,"text":"其他人全死了。","sender":"me","time":"08:55","timestamp":1788396903453,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103873},{"id":1788479768218,"text":"他们俩也想把女主杀死，但是想到上一世的屈辱","sender":"me","time":"08:55","timestamp":1788396912738,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103874},{"id":1788479768219,"text":"他把女主留了下来当自己的徒弟","sender":"me","time":"08:55","timestamp":1788396917062,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103875},{"id":1788479768220,"text":"但是由于女主是个傻子。","sender":"me","time":"08:55","timestamp":1788396921034,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103876},{"id":1788479768221,"text":"特别笨，什么都教不好。","sender":"me","time":"08:55","timestamp":1788396927126,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103877},{"id":1788479768222,"text":"他就老是欺负女主。","sender":"me","time":"08:55","timestamp":1788396930820,"replyTo":null,"userId":"uid_1773229083171_f7agvz9zq","characterId":"aae5161b-9667-424a-95ac-e7041c6f700e","_id":103878}]